# PostgreSQL Connection (Required for Production)
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/whatsapp_agent

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# Meta Official API Credentials
META_VERIFY_TOKEN=your_custom_verification_token
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_system_user_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id

# AI Credentials
OPENAI_API_KEY=your_openai_key
