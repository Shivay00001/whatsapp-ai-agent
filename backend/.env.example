OPENAI_API_KEY=your_openai_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
META_VERIFY_TOKEN=your_meta_webhook_verify_token
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
# DATABASE_URL defaults to postgresql+asyncpg (set to sqlite+aiosqlite:///./app.db for local dev)
# TWILIO_VALIDATE_SIGNATURE defaults to "true". Set to "false"/"0" only for
# local dev (e.g. plain localhost behind no public URL) where the Twilio
# X-Twilio-Signature cannot be validated against the public request URL.
